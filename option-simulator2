</main>

<script>
const canvas=document.getElementById('payoffCanvas');
const ctx=canvas.getContext('2d');
const chart=document.getElementById('chart');
const tooltip=document.getElementById('tooltip');

function fa(n){return Number(n).toLocaleString('fa-IR')}
function resizeCanvas(){
  const r=chart.getBoundingClientRect(), d=window.devicePixelRatio||1;
  canvas.width=r.width*d; canvas.height=r.height*d; canvas.style.width=r.width+'px'; canvas.style.height=r.height+'px';
  ctx.setTransform(d,0,0,d,0,0); draw();
}
function draw(){
  const r=chart.getBoundingClientRect(), w=r.width,h=r.height;
  ctx.clearRect(0,0,w,h);
  const pad={l:45,r:22,t:28,b:34}, cw=w-pad.l-pad.r,ch=h-pad.t-pad.b;
  const xMin=2600,xMax=4100,yMin=-500,yMax=700;
  const X=x=>pad.l+(x-xMin)/(xMax-xMin)*cw;
  const Y=y=>pad.t+(yMax-y)/(yMax-yMin)*ch;

  ctx.strokeStyle='#e8edf2';ctx.lineWidth=1;
  for(let i=0;i<=6;i++){let x=pad.l+cw*i/6;ctx.beginPath();ctx.moveTo(x,pad.t);ctx.lineTo(x,pad.t+ch);ctx.stroke()}
  for(let i=0;i<=5;i++){let y=pad.t+ch*i/5;ctx.beginPath();ctx.moveTo(pad.l,y);ctx.lineTo(pad.l+cw,y);ctx.stroke()}

  ctx.strokeStyle='#94a3b8';ctx.beginPath();ctx.moveTo(pad.l,Y(0));ctx.lineTo(pad.l+cw,Y(0));ctx.stroke();
  ctx.strokeStyle='#c89b3c';ctx.setLineDash([5,4]);ctx.beginPath();ctx.moveTo(X(3480),pad.t);ctx.lineTo(X(3480),pad.t+ch);ctx.stroke();ctx.setLineDash([]);

  ctx.beginPath();
  for(let i=0;i<=180;i++){
    const x=xMin+(xMax-xMin)*i/180;
    const y=Math.max(-180,(x-3480)*.92);
    if(i===0)ctx.moveTo(X(x),Y(y));else ctx.lineTo(X(x),Y(y));
  }
  ctx.strokeStyle='#16835b';ctx.lineWidth=3;ctx.stroke();

  ctx.fillStyle='#64748b';ctx.font='10px Vazirmatn';
  ctx.textAlign='center';
  for(let i=0;i<=6;i++){let x=xMin+(xMax-xMin)*i/6;ctx.fillText(fa(x),X(x),h-11)}
  ctx.textAlign='right';
  [-400,-200,0,200,400,600].forEach(v=>ctx.fillText(fa(v),pad.l-7,Y(v)+3));
  ctx.fillStyle='#9b7421';ctx.font='bold 10px Vazirmatn';ctx.textAlign='left';ctx.fillText('سر به سر',X(3480)+6,pad.t+12);
  ctx.fillStyle='#16835b';ctx.font='bold 11px Vazirmatn';ctx.fillText('سود',w-45,Y(500));
  ctx.fillStyle='#d64545';ctx.fillText('زیان',w-45,Y(-300));
}
canvas.addEventListener('mousemove',e=>{
  const r=canvas.getBoundingClientRect();
  const x=2600+(e.clientX-r.left-45)/(r.width-67)*1500;
  if(x<2600||x>4100){tooltip.style.display='none';return}
  const pnl=Math.max(-180,(x-3480)*.92);
  tooltip.innerHTML='<b>'+fa(Math.round(x))+' ریال</b>سود/زیان تقریبی: '+(pnl>=0?'+':'')+fa(Math.round(pnl))+' ریال';
  tooltip.style.display='block';
  tooltip.style.left=Math.min(e.clientX-r.left+12,r.width-165)+'px';
  tooltip.style.top=Math.max(12,e.clientY-r.top-55)+'px';
});
canvas.addEventListener('mouseleave',()=>tooltip.style.display='none');

function selectStrategy(el,name){
  document.querySelectorAll('.strategy').forEach(x=>x.classList.remove('active'));
  el.classList.add('active');document.getElementById('selectedStrategy').textContent='استراتژی فعال: '+name;
}
function setSide(el){
  el.parentElement.querySelectorAll('button').forEach(x=>x.classList.remove('active'));el.classList.add('active');
}
function addPosition(){
  const type=document.getElementById('type').value;
  const strike=document.getElementById('strike').value;
  const premium=document.getElementById('premium').value;
  const qty=document.getElementById('qty').value;
  const cls=type.toLowerCase()==='put'?'put':type.toLowerCase()==='spot'?'spot':'call';
  const row=document.createElement('tr');
  row.innerHTML='<td><span class="badge '+cls+'">'+type.toUpperCase()+'</span></td><td style="color:var(--green);font-weight:800">خرید</td><td>'+fa(strike)+'</td><td>'+fa(premium)+'</td><td>'+fa(qty)+'</td><td>'+fa(Number(premium)*Number(qty))+'</td><td><button onclick="removeRow(this)" style="border:0;background:none;color:#94a3b8">×</button></td>';
  document.getElementById('positions').appendChild(row);
}
function removeRow(btn){btn.closest('tr').remove()}
function scenario(p){
  const result=p>0?'مثبت':'منفی';
  const est=Math.round((3280*(1+p/100)-3480)*.92);
  const box=document.getElementById('scenarioBox');
  box.innerHTML='<b style="color:'+(p>0?'var(--green)':'var(--red)')+'">سناریوی '+(p>0?'+':'')+p+'٪</b><br><span style="display:block;margin-top:5px">قیمت فرضی دارایی: '+fa(Math.round(3280*(1+p/100)))+' · سود/زیان تقریبی: '+fa(est)+' ریال</span>';
}
function newStrategy(){
  document.querySelectorAll('.strategy').forEach((x,i)=>x.classList.toggle('active',i===0));
  document.getElementById('selectedStrategy').textContent='استراتژی فعال: لانگ کال';
  window.scrollTo({top:0,behavior:'smooth'});
}
function saveStrategy(){alert('در نسخه نهایی، استراتژی در حساب کاربری شمعدون ذخیره خواهد شد.')}
window.addEventListener('resize',resizeCanvas);
resizeCanvas();
</script>
</body>
