          <div class="risk-labels"><span>کم</span><span>متوسط</span><span>زیاد</span></div>
          <div style="height:14px"></div>
          <div class="o-row" style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
            <div style="padding:10px;background:#f8fafc;border-radius:9px"><small style="color:var(--muted);font-size:9px">دلتا</small><b style="display:block;margin-top:4px;font-size:12px">0.54</b></div>
            <div style="padding:10px;background:#f8fafc;border-radius:9px"><small style="color:var(--muted);font-size:9px">تتا</small><b style="display:block;margin-top:4px;font-size:12px;color:var(--red)">−0.08</b></div>
            <div style="padding:10px;background:#f8fafc;border-radius:9px"><small style="color:var(--muted);font-size:9px">وگا</small><b style="display:block;margin-top:4px;font-size:12px">0.11</b></div>
            <div style="padding:10px;background:#f8fafc;border-radius:9px"><small style="color:var(--muted);font-size:9px">گاما</small><b style="display:block;margin-top:4px;font-size:12px">0.003</b></div>
