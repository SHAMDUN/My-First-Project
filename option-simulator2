      <section class="card">
        <div class="card-head"><div><div class="card-title">ابزارهای مرتبط</div><div class="card-sub">ادامه تحلیل در شمعدون</div></div></div>
        <div class="card-body">
          <div class="quick-actions">
            <button class="quick">محاسبه‌گر سود/زیان</button>
            <button class="quick">ماشین‌حساب موقعیت</button>
            <button class="quick">دیده‌بان آپشن</button>
